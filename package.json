{
  "name": "@szluyu99/dsh-oneapi",
  "version": "1.0.0",
  "description": "OneAPI gateway configuration and status panel for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "oneapi",
    "llm-provider"
  ],
  "license": "MIT",
  "author": "szluyu99",
  "homepage": "https://github.com/szluyu99/dsh-oneapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szluyu99/dsh-oneapi.git"
  },
  "bugs": {
    "url": "https://github.com/szluyu99/dsh-oneapi/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  }
}
